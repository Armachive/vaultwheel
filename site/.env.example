# for site/docker-compose.yml: copy to .env beside the compose file and fill it in. .env stays out of git
# the password in the page's address: 16 characters or more
TREE_TOKEN=change-me-to-a-long-random-string
# the vault on this machine, and the name it goes by
VAULT_PATH=/path/to/your/vault
VAULT_NAME=MyVault
# the user:group the server runs as, one that can read the vault
SITE_USER=1000:1000
# the sites allowed to show the page in a frame, spaces between, for example https://example.com
FRAME_ANCESTORS="'self'"
