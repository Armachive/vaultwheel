# tools/deploy.sh reads tools/deploy.env (not in git). copy this file to it and fill it in for your machine.
# where the site's app folder is (the folder holding index.html and server.py) and who owns its files
APP=/path/to/vault-tree/app
APP_OWNER=1000:1000
# the site's container, restarted when server.py changes
SITE_CONTAINER=vault-tree
# the plugin's folder in the vault, and who owns its files
PLUG=/path/to/your/vault/.obsidian/plugins/vaultwheel
PLUG_OWNER=youruser:yourgroup
# who the deploy commits as, and the GitHub repo it pushes to (owner/name)
GIT_NAME="Your Name"
GIT_EMAIL=you@example.com
GIT_REPO=youruser/vaultwheel
# a text file holding a GitHub token, found in it by its ghp_ or github_pat_ prefix. the token itself never goes in here
GIT_TOKEN_FILE=/path/to/github-token.txt
# where build/vaultwheel-final.html gets published by hand, said at the end of a deploy (may be empty)
PREVIEW_URL=
